# MongoDB connection string — MUST include the database name, e.g. /fashion-store
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/fashion-store?appName=Cluster0

# NextAuth / Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay — https://dashboard.razorpay.com/app/website-app-settings/api-keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Public base URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
